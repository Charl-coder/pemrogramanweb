<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CH.SehatKita - Home</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <div class="container nav-container">

        <h1 class="logo">CH.SehatKita</h1>

        <nav>
            <ul>
                <li><a href="index.html" class="active">Home</a></li>
                <li><a href="about.html">About</a></li>
                <li><a href="services.html">Services</a></li>
            </ul>
        </nav>

    </div>
</header>

<!-- HERO -->
<section class="hero">

    <div class="container hero-content">

        <div>
            <h2>Kesehatan Anda Prioritas Kami</h2>

            <p>
                Klinik modern dengan layanan kesehatan terpercaya,
                profesional, nyaman, dan siap melayani seluruh keluarga.
            </p>

            <button onclick="scrollToForm()">
                Buat Janji
            </button>
        </div>

    </div>

</section>

<!-- FEATURES -->
<section class="features container">

    <div class="card">
        <h3>Dokter Profesional</h3>
        <p>Ditangani langsung oleh tenaga medis berpengalaman.</p>
    </div>

    <div class="card">
        <h3>Pelayanan Cepat</h3>
        <p>Pelayanan modern dengan sistem yang efisien.</p>
    </div>

    <div class="card">
        <h3>Fasilitas Lengkap</h3>
        <p>Ruangan nyaman dan peralatan medis lengkap.</p>
    </div>

</section>

<!-- APPOINTMENT -->
<section id="appointment" class="appointment-section">

    <div class="container">

        <div class="section-title">
            <h3>Form Janji Pasien</h3>
            <p>Silahkan isi form untuk membuat janji pemeriksaan</p>
        </div>

        <form class="appointment-form">

            <input type="text" placeholder="Nama Lengkap" required>

            <input type="email" placeholder="Email" required>

            <input type="number" placeholder="Nomor Telepon" required>

            <select required>
                <option value="">Pilih Layanan</option>
                <option>Konsultasi Dokter</option>
                <option>Vaksinasi</option>
                <option>Laboratorium</option>
            </select>

            <input type="date" required>

            <textarea rows="5" placeholder="Keluhan Pasien"></textarea>

            <button type="submit">
                Kirim Janji
            </button>

        </form>

    </div>

</section>

<footer>
    <div class="container">
        <p>&copy; 2025 CH.SehatKita. All Rights Reserved.</p>
    </div>
</footer>

<script>

function scrollToForm(){

    document.getElementById("appointment").scrollIntoView({
        behavior:"smooth"
    });

}

</script>

</body>
</html>
